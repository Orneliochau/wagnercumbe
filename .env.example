# Copie para .env apenas se for testar localmente. NUNCA faça commit do .env.
# Em produção, defina estas variáveis no painel da Vercel (Settings → Environment Variables).

# Público (lido no build e injectado no HTML)
META_PIXEL_ID=
CHECKOUT_URL=

# Secreto — só no servidor (api/capi.js). Nunca no HTML/JS do browser.
META_ACCESS_TOKEN=

# Opcionais
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=
SITE_URL=
ALLOWED_ORIGINS=
